{
  "name": "gno-mobile-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source non-custodial mobile and web wallet for gno.land",
  "license": "Apache-2.0",
  "homepage": "https://gno-mobile-wallet.netlify.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunny-0x42/gno-mobile-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/sunny-0x42/gno-mobile-wallet/issues"
  },
  "keywords": [
    "gno",
    "gnoland",
    "gno.land",
    "wallet",
    "expo",
    "react-native",
    "web3",
    "tm2"
  ],
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "web:lan": "expo start --web --host lan --port 8081",
    "web:export": "expo export --platform web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "prebuild": "expo prebuild",
    "ts:check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "ext:dev": "vite build --config extension/vite.config.ts --watch",
    "ext:build": "vite build --config extension/vite.config.ts",
    "eas:login": "eas login",
    "eas:init": "eas init",
    "build:ios": "eas build --platform ios --profile preview",
    "build:ios:mock": "eas build --platform ios --profile preview-mock",
    "build:ios:prod": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@cosmjs/crypto": "^0.38.1",
    "@expo/metro-runtime": "~3.2.3",
    "@gnolang/gno-js-client": "^2.0.3",
    "@gnolang/gnonative": "^3.0.2",
    "@gnolang/tm2-js-client": "^2.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "expo": "~51.0.39",
    "expo-blur": "~13.0.2",
    "expo-clipboard": "~6.0.3",
    "expo-haptics": "~13.0.1",
    "expo-linking": "~6.3.1",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-get-random-values": "^1.11.0",
    "react-native-polyfill-globals": "^3.1.0",
    "react-native-qrcode-svg": "^6.3.12",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.12",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/chrome": "^0.2.5",
    "@types/react": "~18.2.79",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.3.3",
    "vite": "^5.4.21"
  }
}
